{
  "name": "event-storming-plugin",
  "displayName": "Event Storming Diagram Renderer",
  "publisher": "rexebin",
  "version": "1.0.0",
  "description": "Render event storming diagrams on GitHub and in VS Code Markdown preview.",
  "icon": "icon.png",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rexebin/event-storming-plugin.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "event storming",
    "markdown",
    "diagram",
    "json",
    "vscode"
  ],
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:vscode": "npm run build && npx @vscode/vsce package"
  },
  "contributes": {
    "markdown.previewScripts": [
      "./dist/vscode-preview.js"
    ],
    "markdown.previewStyles": [
      "./style.css"
    ]
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "packageManager": "npm@11.16.0"
}